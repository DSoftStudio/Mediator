<Project>
  <PropertyGroup>
    <!-- Enable interceptors for transitive consumers as well.
         When NuGet sees both build/ and buildTransitive/ with the same filename,
         buildTransitive/ takes priority even for direct PackageReference consumers.
         Without these properties the source generator emits interceptors but the
         compiler rejects them with CS9137.

         To suppress interceptor generation (e.g. in test projects that mock ISender),
         set DSoftMediatorSuppressInterceptors to true:

           <DSoftMediatorSuppressInterceptors>true</DSoftMediatorSuppressInterceptors>
    -->
    <InterceptorsPreviewNamespaces Condition="'$(DSoftMediatorSuppressInterceptors)' != 'true'">$(InterceptorsPreviewNamespaces);DSoftStudio.Mediator.Generated</InterceptorsPreviewNamespaces>
    <InterceptorsNamespaces Condition="'$(DSoftMediatorSuppressInterceptors)' != 'true'">$(InterceptorsNamespaces);DSoftStudio.Mediator.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <!-- Expose the flags to the source generator via AnalyzerConfigOptionsProvider.
       DSoftMediatorDisableAggressive: force-off escape hatch for the ADR-0065 AGGRESSIVE
       dispatch tier (see build/DSoftStudio.Mediator.props for when to set it). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="DSoftMediatorSuppressInterceptors" />
    <CompilerVisibleProperty Include="DSoftMediatorDisableAggressive" />
  </ItemGroup>
</Project>
