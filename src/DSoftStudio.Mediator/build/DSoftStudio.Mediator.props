<Project>
  <PropertyGroup>
    <!-- Enable interceptors for the DSoftStudio.Mediator source generator.
         The generator emits interceptor methods in this namespace to replace
         ISender.Send<,>() calls with direct pipeline invocation.

         To suppress interceptor generation (e.g. in test projects that mock ISender
         and build in Release), set DSoftMediatorSuppressInterceptors to true:

           <DSoftMediatorSuppressInterceptors>true</DSoftMediatorSuppressInterceptors>
    -->
    <InterceptorsPreviewNamespaces Condition="'$(DSoftMediatorSuppressInterceptors)' != 'true'">$(InterceptorsPreviewNamespaces);DSoftStudio.Mediator.Generated</InterceptorsPreviewNamespaces>
    <InterceptorsNamespaces Condition="'$(DSoftMediatorSuppressInterceptors)' != 'true'">$(InterceptorsNamespaces);DSoftStudio.Mediator.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <!-- Expose the property to the source generator via AnalyzerConfigOptionsProvider -->
  <ItemGroup>
    <CompilerVisibleProperty Include="DSoftMediatorSuppressInterceptors" />
  </ItemGroup>
</Project>
