<Project>

	<PropertyGroup>
		<!-- Strong naming: all assemblies signed with the same key -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)DSoftStudio.Mediator.snk</AssemblyOriginatorKeyFile>
		<PublicKey></PublicKey>
		<PublicKeyToken>6c7e753832e8eb05</PublicKeyToken>
	</PropertyGroup>

</Project>
